# 阿里云 AccessKey（OSS 上传 + 生成签名 URL）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# OSS，必须与百炼同地域：华北2（北京），bucket 权限设为私有
ALIYUN_OSS_REGION=oss-cn-beijing
ALIYUN_OSS_BUCKET=

# 百炼（DashScope）Fun-ASR，必须是「华北2（北京）」地域的 Key，新加坡/美国的 Key 会鉴权失败
DASHSCOPE_API_KEY=
# 百炼控制台 -> 业务空间管理 复制，用于拼 Base URL
DASHSCOPE_WORKSPACE_ID=

# 可选：Fun-ASR 每分钟单价（元），用于 spike 脚本估算本次转写费用；不填则跳过费用估算
FUNASR_PRICE_PER_MINUTE_CNY=

# Trigger.dev（任务 1.2 队列方案验证）：project ref 来自 dashboard 项目设置页，
# TRIGGER_SECRET_KEY 用 dev 环境的 secret key（tr_dev_...）
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
