# 阿里云 AccessKey（OSS 上传 + 生成签名 URL）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# OSS，必须与百炼同地域：华北2（北京），bucket 权限设为私有
ALIYUN_OSS_REGION=oss-cn-beijing
ALIYUN_OSS_BUCKET=

# 百炼（DashScope）Fun-ASR，必须是「华北2（北京）」地域的 Key，新加坡/美国的 Key 会鉴权失败
DASHSCOPE_API_KEY=
# 百炼控制台 -> 业务空间管理 复制，用于拼 Base URL
DASHSCOPE_WORKSPACE_ID=

# 可选：Fun-ASR 每分钟单价（元），用于 spike 脚本估算本次转写费用；不填则跳过费用估算
FUNASR_PRICE_PER_MINUTE_CNY=

# Trigger.dev（任务 1.2 队列方案验证）：project ref 来自 dashboard 项目设置页，
# TRIGGER_SECRET_KEY 用 dev 环境的 secret key（tr_dev_...）
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Supabase（任务 1.4 数据库 + 任务 1.5 认证用）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key 只在服务端用（越权 RLS 测试、后台任务），千万不要加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=

# LLM：直接复用上面百炼的 DASHSCOPE_API_KEY 调 Qwen，省一个账号；
# 如果之后切换到 DeepSeek，在这里加 DEEPSEEK_API_KEY 并在 lib/ai 适配层切 provider
