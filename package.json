{
  "name": "podcast-studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "spike-asr": "tsx scripts/spike-asr.ts",
    "spike-queue": "tsx scripts/spike-queue.ts",
    "trigger:dev": "trigger.dev dev --env-file .env.local"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/supabase-js": "^2.111.0",
    "@trigger.dev/sdk": "^4.5.8",
    "ali-oss": "^6.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "lucide-react": "^1.27.0",
    "next": "15.5.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@trigger.dev/build": "^4.5.8",
    "@types/ali-oss": "^6.16.11",
    "@types/node": "^20.14.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4",
    "trigger.dev": "^4.5.8",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.4"
  }
}
